# Password for the admin area (/admin)
ADMIN_PASSWORD=bitte-aendern

# Extra key material for the admin session cookie
ADMIN_SECRET=

# Deprecated: the shared secret of the old shortcut setup. Every installation
# carried the same copy, so it identified nobody. Devices now enrol themselves
# under /kurzbefehl. Keep it set until the last shortcut has been switched
# over, then remove it.
REPORT_TOKEN=

# Key material for device tokens and the enrollment challenges. Falls back to
# REPORTER_SALT. Changing it invalidates every issued token.
CLIENT_TOKEN_SECRET=

# Size of the search space a device works through to be enrolled. Larger costs
# the visitor more time, and an automated caller correspondingly more.
POW_RANGE=30000

# The surge brake. Once an hour reaches SURGE_FACTOR times the median of the
# last fortnight — but never below SURGE_FLOOR — reports from devices without
# a history are held for review instead of published directly.
SURGE_FLOOR=40
SURGE_FACTOR=4

# Salt for the reporter check value used for abuse protection
REPORTER_SALT=

# Number of proxies in front of the app whose X-Forwarded-For entries may be
# trusted. Railway alone: 1. Behind an extra CDN: 2. Too high a value lets
# senders fake their address and bypass the rate limit.
TRUSTED_PROXY_HOPS=1

# Alternative single header carrying the verified client address, for example
# cf-connecting-ip. Takes precedence over X-Forwarded-For when set.
CLIENT_IP_HEADER=

# Path to the SQLite file (default: ./data/bye-schlachthof.db)
DATABASE_PATH=

# Origins allowed to write to the API (comma separated, "*" opens it fully).
# When empty, BASE_URL applies.
API_CORS_ORIGINS=

# Public address, read at runtime. Drives the CORS allowance for writes and is
# changeable without a rebuild.
BASE_URL=

# Public address used for metadata and the shortcut page. Inlined at build time.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# iCloud link of the finished iPhone shortcut
NEXT_PUBLIC_SHORTCUT_URL=
