# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection. On Vercel the Postgres integration injects POSTGRES_URL
# automatically, so this only needs setting for local development.
DATABASE_URL=postgresql://localhost:5432/bye_schlachthof

# Password for the admin area (/admin). Without it the admin area stays
# disabled — there is no default.
ADMIN_PASSWORD=bitte-aendern

# ---------------------------------------------------------------------------
# Optional — the app derives a working value when these are unset
# ---------------------------------------------------------------------------

# Token that marks trusted clients (the iPhone shortcut) and raises their limit
# from 12 to 40 reports per hour. Unset means no token is enforced.
REPORT_TOKEN=

# Extra key material for the admin session cookie.
# Unset: derived from the database URL. Changing it signs every admin out.
ADMIN_SECRET=

# Salt for the reporter check value used for abuse protection.
# Unset: derived from the database URL.
REPORTER_SALT=

# Public address. Unset: taken from Vercel's own VERCEL_PROJECT_PRODUCTION_URL
# or VERCEL_URL, otherwise http://localhost:3000.
BASE_URL=

# Same address for metadata and the shortcut page. Inlined at build time.
# Unset: same fallback chain as BASE_URL.
NEXT_PUBLIC_BASE_URL=

# Extra origins allowed to write to the API (comma separated, "*" opens it
# fully). Only needed when a frontend on another domain should submit reports.
API_CORS_ORIGINS=

# iCloud link of the iPhone shortcut. Unset: the published "Bye Schlachthof"
# shortcut baked into the page is used. Set this to ship your own instead.
NEXT_PUBLIC_SHORTCUT_URL=
